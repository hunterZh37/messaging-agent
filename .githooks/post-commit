#!/usr/bin/env bash
# Re-render docs/diagrams/system-architecture.html whenever the archify JSON changes.
# Enable per clone: git config core.hooksPath .githooks
# Spec: docs/superpowers/specs/2026-09-06-archify-agent-design.md
#       docs/superpowers/specs/2026-09-21-live-diagram-design.md (background sync)

[ -n "$ARCHIFY_HOOK" ] && exit 0
cd "$(git rev-parse --show-toplevel)" || exit 0
json=docs/diagrams/system-architecture.json
html=docs/diagrams/system-architecture.html
archify=~/.claude/skills/archify/bin/archify.mjs
sha=$(git rev-parse --short HEAD)
gitdir=$(git rev-parse --git-dir)
log="$gitdir/archify.log"

if ! git diff-tree --root --no-commit-id --name-only -r HEAD | grep -qx "$json"; then
  : # diagram untouched; see the sync section below
elif [ ! -f "$archify" ]; then
  echo "archify hook: $archify not found, HTML not re-rendered" >&2
elif node "$archify" deliver architecture "$json" "$html" --quality showcase --json > "$gitdir/archify.last-output" 2>&1; then
  if git diff --quiet -- "$html"; then
    echo "$(date '+%FT%T') $sha rendered, html unchanged" >> "$log"
  else
    ARCHIFY_HOOK=1 git commit -q -o -m "diagram: render $sha" -- "$html" \
      && echo "$(date '+%FT%T') $sha rendered, committed $(git rev-parse --short HEAD)" >> "$log"
  fi
else
  echo "archify hook: deliver failed for $sha, see $gitdir/archify.last-output" >&2
  echo "$(date '+%FT%T') $sha deliver-failed" >> "$log"
fi

# The commit changed the system's shape but not the diagram, and was made
# outside Claude Code (pre-commit makes a Claude session do it itself): hand it
# to the background sync agent. DIAGRAM_AUTOSYNC=0 turns this off.
[ "$CLAUDECODE" = "1" ] && exit 0
[ "$DIAGRAM_AUTOSYNC" = "0" ] && exit 0
[ "$DIAGRAM_UNCHANGED" = "1" ] && exit 0
[ -f tools/diagram-drift.mjs ] || exit 0
command -v node >/dev/null || { echo "diagram hook: node not found, drift not checked" >&2; exit 0; }
node tools/diagram-drift.mjs --commit HEAD > /dev/null 2>&1
if [ $? -eq 1 ]; then
  nohup tools/diagram-sync.sh "$(git rev-parse HEAD)" > /dev/null 2>&1 &
  echo "diagram: sync agent started in the background (log: $gitdir/archify.log)"
fi
exit 0
