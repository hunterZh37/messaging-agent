# Copy to .env and fill in. Nothing here is committed: .env and .env.* are
# gitignored. The only value that is strictly required is the Anthropic key.

# Required. Sorting, drafting and Ask all run through it.
ANTHROPIC_API_KEY=

# Optional. What Celeste calls you when she answers about "your" mail.
# Unset, she says "the operator", and nothing breaks.
CELESTE_OPERATOR_NAME=

# --- Inboxes -----------------------------------------------------------
# Gmail and other IMAP mailboxes: "Sign in with Google" needs an OAuth client
# of your own. Google Cloud console > APIs & Services > Credentials > Create
# credentials > OAuth client ID > Web application. Add this redirect URI:
#   http://127.0.0.1:3100/api/auth/google/callback
# Other IMAP servers use a host and an app password entered in the UI instead,
# and need nothing here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outlook.com / Microsoft 365. Azure portal > App registrations > New
# registration, "Accounts in any organizational directory and personal
# Microsoft accounts", redirect URI http://127.0.0.1:3100/api/oauth/microsoft/callback.
# Only the client id is needed; the flow is public-client with PKCE.
MICROSOFT_CLIENT_ID=

# --- Serving the app ---------------------------------------------------
# Required by scripts/celeste-server/install.sh, which runs the app as a
# background service. At least 8 characters. It is what the phone types once.
CELESTE_PASSCODE=

# Web Push, so the phone can be notified. Generate a keypair with:
#   npx web-push generate-vapid-keys
# The subject is how a push service reaches whoever runs this instance: a
# mailto: or a URL. Without all three, notifications simply stay off.
CELESTE_VAPID_PUBLIC=
CELESTE_VAPID_PRIVATE=
CELESTE_VAPID_SUBJECT=

# Optional. Where the database, attachments and the prompt files live.
# Default: ~/messaging-agent
MESSAGING_AGENT_DATA_DIR=

# --- Chats on this Mac (macOS only) ------------------------------------
# Optional overrides. Both default to the real app locations, and both need
# Full Disk Access granted to whatever runs the app.
# CELESTE_CHAT_DB=~/Library/Messages/chat.db
# CELESTE_WHATSAPP_DB=~/Library/Group Containers/group.net.whatsapp.WhatsApp.shared/ChatStorage.sqlite

# --- Models ------------------------------------------------------------
# Optional. Which model answers for each job. A bare name means Anthropic;
# prefix with ollama: to run the role on a local model instead.
# Defaults: claude-haiku-4-5 for sorting, claude-sonnet-5 for the other two.
# CELESTE_MODEL_SORTER=ollama:qwen3:8b
# The model for bulk sorting jobs (first sync, Sort older, Re-sort, backfill).
# Unset, it is whatever CELESTE_MODEL_SORTER resolved to.
# CELESTE_MODEL_SORTER_BACKLOG=claude-haiku-4-5
# CELESTE_MODEL_DRAFTER=
# CELESTE_MODEL_CHAT=
# Optional. The model that reads your own tone back to you on the Stats page.
# Local by default and deliberately so: it reads a sample of tens of thousands
# of your own messages, and nothing about them should leave the machine. Needs
# `ollama pull qwen3:8b`. Default: ollama:qwen3:8b
# CELESTE_MODEL_STATS=
# Optional. Where Ollama listens, for embeddings and any local model.
# Default: http://127.0.0.1:11434
# OLLAMA_URL=

# --- A scheduling agent, optional --------------------------------------
# "Add to Alex" hands an actionable or an event from a mail thread to a
# scheduling agent over MCP. Both halves are yours: there is no default
# server, so leaving these unset simply means the button says it is not
# connected. See docs/SCHEDULING.md.
ALEX_MCP_URL=
ALEX_MCP_TOKEN=

# --- Development -------------------------------------------------------
# Set to 1 to start the web app without its background sync and sort loops.
# CELESTE_NO_BACKGROUND=1
