  "cards": [
    {
      "dot": "cyan",
      "title": "Data model",
      "items": [
        "One account, provider imessage, shown under its own Messages section",
        "Thread = one chat (guid); subject = contact name or number",
        "Message = one text (guid); from = handle, isFromOperator = is_from_me",
        "folder always inbox; sentAt from Apple nanoseconds since 2001",
        "contacts cache: handle, name, refreshedAt"
      ]
    },
    {
      "dot": "violet",
      "title": "Sync and decoding",
      "items": [
        "chat.db opened read-only (WAL); highest ROWID kept as the watermark",
        "attributedBody decoded to text (2,792 of 2,833 recent messages have no plain text)",
        "One-to-one chats only, 30 days on connect, then live every 15 s",
        "Edits and unsends in Messages ignored; a deleted chat stays until deleted here"
      ]
    },
    {
      "dot": "rose",
      "title": "Sending",
      "items": [
        "Same gate as mail: draft, preview, Send, six seconds with Undo",
        "osascript tells Messages.app to send to the handle on iMessage, SMS or RCS",
        "First send asks macOS to allow control of Messages, once",
        "No unsend exists; the six seconds are the safety net"
      ]
    },
    {
      "dot": "emerald",
      "title": "Sorter and drafter",
      "items": [
        "Sorter on local qwen3: needs reply, importance; no dollar cost",
        "Drafter on Sonnet with a text flavour: short, no greeting, no signature, matches the chat's tone",
        "Ask Celeste searches texts beside mail, cites them the same way"
      ]
    },
    {
      "dot": "amber",
      "title": "Permissions and failures",
      "items": [
        "Node needs Full Disk Access, granted in System Settings",
        "chat.db busy: retry next tick; never write to it",
        "Messages.app not running: launched by the send; not signed in: the send fails and says so",
        "Contact not found: the number is the name"
      ]
    },
    {
      "dot": "slate",
      "title": "Not in this phase",
      "items": [
        "Group chats",
        "History older than 30 days",
        "Reactions, edits, unsends",
        "Sending attachments"
      ]
    }
  ]
